+     */
+    private static function normalizeGolongan(string $golongan): string
+    {
+        $g = strtoupper(trim($golongan));
+        // Hapus karakter pemisah: titik, garis miring, spasi
+        $g = preg_replace('/[\s.\/\-]+/', '', $g);
+        return $g;
+    }
